{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Страница",
    "description": "Страница сайта, собранная из блоков"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.hero",
        "blocks.feature-grid",
        "blocks.steps",
        "blocks.security-list",
        "blocks.case-cards",
        "blocks.faq",
        "blocks.lead-form"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "parts.seo"
    }
  }
}
