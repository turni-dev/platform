{
  "name": "cms",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cms/src",
  "projectType": "application",
  "targets": {
    "build": {
      "command": "strapi build",
      "options": { "cwd": "apps/cms" }
    },
    "serve": {
      "command": "strapi develop",
      "options": { "cwd": "apps/cms" }
    },
    "test": {
      "command": "vitest run --config vitest.config.ts apps/cms/src"
    },
    "start": {
      "command": "strapi start",
      "options": { "cwd": "apps/cms" }
    }
  },
  "tags": ["scope:cms", "type:app"]
}
