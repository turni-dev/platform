{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "targets": {
    "build": {
      "command": "next build --webpack",
      "options": { "cwd": "apps/web" }
    },
    "serve": {
      "command": "next dev --webpack --hostname 0.0.0.0 --port 3001",
      "options": { "cwd": "apps/web" }
    },
    "test": { "command": "vitest run --config vitest.config.ts apps/web/src" },
    "lint": { "command": "eslint apps/web/src/**/*.{ts,tsx}" },
    "typecheck": { "command": "tsc -p apps/web/tsconfig.json --noEmit" }
  },
  "tags": ["scope:web", "type:app"]
}
