{
  "name": "widget",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/widget/src",
  "projectType": "library",
  "targets": {
    "build": {
      "command": "tsc -p packages/widget/tsconfig.build.json"
    },
    "check-size": {
      "dependsOn": [
        "build"
      ],
      "command": "node tools/widget/check-bundle-size.mjs dist/packages/widget/index.js"
    },
    "check-size-test": {
      "command": "vitest run tools/widget/check-bundle-size.spec.mjs"
    },
    "test": {
      "command": "vitest run --config vitest.config.ts packages/widget/src"
    },
    "lint": {
      "command": "eslint packages/widget/src/**/*.ts"
    },
    "typecheck": {
      "command": "tsc -p packages/widget/tsconfig.lib.json --noEmit"
    }
  },
  "tags": [
    "scope:widget",
    "type:boundary"
  ]
}
