# Copy outside the repository as /srv/turni/config/product.env and set mode 0600.
PRODUCT_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=turni
POSTGRES_USER=turni
POSTGRES_PASSWORD=replace_with_a_random_database_password
DATABASE_URL=postgresql://turni:replace_with_a_random_database_password@postgres:5432/turni

WIDGET_SESSION_SECRET=replace_with_a_unique_random_value_at_least_32_characters
WIDGET_ROUTING_SECRET=replace_with_a_unique_random_value_at_least_32_characters
OWNER_AUTH_SECRET=replace_with_a_unique_random_value_at_least_32_characters
WEBHOOK_ROUTING_SECRET=replace_with_a_unique_random_value_at_least_32_characters
PUBLIC_WEBHOOK_ORIGIN=https://api.turni.ru
APP_ORIGIN=https://app.turni.ru

SMTP_HOST=mail.hosting.reg.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@turni.ru
SMTP_PASSWORD=replace_with_the_rotated_smtp_password
EMAIL_FROM=hello@turni.ru
