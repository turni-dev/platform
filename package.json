{
  "name": "turni",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "!apps/cms",
    "packages/*"
  ],
  "scripts": {
    "nx": "nx",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "coverage": "nx run-many -t coverage",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node tools/bootstrap/demo-seed.mjs",
    "secrets:init": "node tools/bootstrap/secret-bootstrap.mjs",
    "eval": "tsx tools/bootstrap/eval-runner.ts",
    "db:migrate": "node tools/bootstrap/db-migrate.mjs"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.8.5",
    "next": "^16.2.10",
    "next-intl": "^4.13.1",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nx/eslint-plugin": "^21.6.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "nx": "^21.6.3",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
